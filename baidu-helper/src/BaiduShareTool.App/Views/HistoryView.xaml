<UserControl x:Class="BaiduShareTool.App.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="HistoryView_Loaded">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><StackPanel><TextBlock Text="历史导出记录" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="查看导出时间、目录和处理结果" Foreground="#667085" Margin="0,7,0,18"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding RefreshMessage}" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="刷新记录" Click="HistoryView_Loaded" Background="#EEF4FF" Foreground="#1D4ED8" Padding="14,8"/></StackPanel></DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="导出任务" Foreground="#667085"/><TextBlock Text="{Binding Records.Count}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="最近导出" Foreground="#667085"/><TextBlock Text="{Binding Records[0].LocalExportTime, StringFormat={}{0:MM-dd HH:mm}}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="记录状态" Foreground="#667085"/><TextBlock Text="已就绪" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" Foreground="#087443"/></StackPanel></Border></Grid>
    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="10"><DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" RowHeight="48" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="导出时间" Binding="{Binding LocalExportTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/><DataGridTextColumn Header="导出目录" Binding="{Binding RootPath}" Width="2*"/><DataGridTextColumn Header="文件数量" Binding="{Binding FileCount}" Width="80"/><DataGridTextColumn Header="成功" Binding="{Binding SuccessCount}" Width="80"/><DataGridTextColumn Header="失败" Binding="{Binding FailedCount}" Width="80"/><DataGridTemplateColumn Header="操作" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="打开 Excel" Click="OpenHistory_Click" Margin="0,0,6,0" Padding="10,5"/><Button Content="删除" Click="DeleteHistory_Click" Foreground="#B42318" Padding="10,5"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
  </Grid>
</UserControl>
