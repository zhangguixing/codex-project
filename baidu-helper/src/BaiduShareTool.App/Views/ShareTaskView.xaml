<UserControl x:Class="BaiduShareTool.App.Views.ShareTaskView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="&#x521B;&#x5EFA;&#x5206;&#x4EAB;&#x4EFB;&#x52A1;" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="&#x4EFB;&#x52A1;&#x5728;&#x540E;&#x53F0;&#x8FD0;&#x884C;&#xFF0C;&#x7A97;&#x53E3;&#x4FDD;&#x6301;&#x54CD;&#x5E94;&#x3002;" Foreground="#667085" Margin="0,7,0,24" />
        <Border Style="{StaticResource PanelStyle}" Padding="22">
            <StackPanel>
                <TextBlock Text="&#x767E;&#x5EA6;&#x7F51;&#x76D8;&#x76EE;&#x5F55;" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="100" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="8" /><ColumnDefinition Width="80" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="8" /><ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#D7DDE8" BorderThickness="1" CornerRadius="6" Padding="10,7" MinHeight="42"><TextBlock Text="{Binding DirectoryState.DisplayPath}" TextWrapping="Wrap" Foreground="#344054" VerticalAlignment="Center" /></Border>
                    <Button Grid.Column="2" Content="&#x6D4F;&#x89C8;&#x76EE;&#x5F55;" Click="BrowseDirectory_Click" Background="#E8F0FF" Foreground="#1D4ED8" />
                    <Button Grid.Column="4" Content="&#x5F00;&#x59CB;" Click="Start_Click" Background="#2563EB" Foreground="White" />
                    <Button Grid.Column="6" Content="&#x6682;&#x505C;" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" Background="#FFF4D6" Foreground="#92400E" />
                    <Button Grid.Column="8" Content="&#x7EE7;&#x7EED;" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" Background="#E7F8EF" Foreground="#166534" />
                    <Button Grid.Column="10" Content="&#x4E22;&#x5F03;" Command="{Binding DiscardCommand}" IsEnabled="{Binding CanDiscard}" Background="#FEECEC" Foreground="#B42318" />
                </Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="#98A2B3" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="20"><StackPanel><TextBlock Text="&#x4EFB;&#x52A1;&#x72B6;&#x6001;" Foreground="#667085" /><TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20"><StackPanel><TextBlock Text="&#x5904;&#x7406;&#x8FDB;&#x5EA6;" Foreground="#667085" /><TextBlock Text="{Binding ProgressText}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border></Grid>
        <Border Style="{StaticResource PanelStyle}" Padding="20" Margin="0,16,0,0"><StackPanel><DockPanel><TextBlock Text="&#x4EFB;&#x52A1;&#x8FDB;&#x5EA6;" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding ProgressText}" DockPanel.Dock="Right" Foreground="#2563EB" /></DockPanel><ProgressBar Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="10" Margin="0,12,0,18" /><DockPanel><TextBlock Text="&#x5B9E;&#x65F6;&#x65E5;&#x5FD7;" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Foreground="#98A2B3" /></DockPanel><ListBox ItemsSource="{Binding Logs}" Height="170" Margin="0,14,0,0" Background="#F8FAFC" BorderThickness="0" Padding="12" /></StackPanel></Border>
    </StackPanel>
</UserControl>
