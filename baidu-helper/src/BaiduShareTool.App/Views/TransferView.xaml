<UserControl x:Class="BaiduShareTool.App.Views.TransferView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="&#x6279;&#x91CF;&#x8F6C;&#x5B58;" FontSize="25" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="&#x4ECE;&#x5206;&#x4EAB;&#x94FE;&#x63A5;&#x5C06;&#x6587;&#x4EF6;&#x8F6C;&#x5165;&#x60A8;&#x9009;&#x5B9A;&#x7684;&#x767E;&#x5EA6;&#x7F51;&#x76D8;&#x76EE;&#x5F55;&#x3002;" Foreground="#667085" Margin="0,7,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#EAFBF2" BorderBrush="#C6EAD5" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding IsLoggedIn, StringFormat=&#x767B;&#x5F55;&#x72B6;&#x6001;&#xFF1A;{0}}" Foreground="#087443" FontSize="12" />
            </Border>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="01  &#x5206;&#x4EAB;&#x6765;&#x6E90;" FontWeight="SemiBold" Foreground="#1D4ED8" />
                    <TextBlock Text="&#x5206;&#x4EAB;&#x94FE;&#x63A5;" FontWeight="SemiBold" Margin="0,20,0,7" />
                    <TextBox Text="{Binding ShareLinks, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="128" ToolTip="&#x6BCF;&#x884C;&#x4E00;&#x6761;&#x5206;&#x4EAB;&#x94FE;&#x63A5;&#xFF0C;&#x94FE;&#x63A5;&#x672B;&#x5C3E;&#x9700;&#x5305;&#x542B; pwd &#x63D0;&#x53D6;&#x7801;&#x3002;" />
                    <TextBlock Text="&#x6BCF;&#x884C;&#x7C98;&#x8D34;&#x4E00;&#x6761;&#x5206;&#x4EAB;&#x94FE;&#x63A5;&#x3002;&#x63D0;&#x53D6;&#x7801;&#x4ECE;&#x94FE;&#x63A5;&#x672B;&#x5C3E;&#x7684; pwd &#x53C2;&#x6570;&#x81EA;&#x52A8;&#x8BFB;&#x53D6;&#x3002;" Foreground="#667085" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="24" BorderBrush="#BED4FC">
                <StackPanel>
                    <TextBlock Text="02  &#x5904;&#x7406;&#x8303;&#x56F4;" FontWeight="SemiBold" Foreground="#1D4ED8" />
                    <TextBlock Text="&#x9ED8;&#x8BA4;&#x4E00;&#x6B21;&#x8F6C;&#x5B58;&#x5168;&#x90E8;&#x9879;&#x76EE;&#x3002;" Foreground="#344054" TextWrapping="Wrap" Margin="0,20,0,16" />
                    <CheckBox Content="&#x542F;&#x7528;&#x5206;&#x6279;&#x8F6C;&#x5B58;" IsChecked="{Binding SplitIntoBatches}" FontWeight="SemiBold" />
                    <TextBlock Text="&#x52FE;&#x9009;&#x540E;&#x6BCF;&#x6B21;&#x8F6C;&#x5B58; 500 &#x9879;&#xFF0C;&#x5E76;&#x81EA;&#x52A8;&#x7EE7;&#x7EED;&#x76F4;&#x81F3;&#x5B8C;&#x6210;&#x3002;" Foreground="#667085" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource PanelStyle}" Padding="24" Margin="0,16,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="03  &#x8F6C;&#x5B58;&#x76EE;&#x5F55;" FontWeight="SemiBold" Foreground="#1D4ED8" /><TextBlock Text="{Binding DirectoryState.DisplayPath}" Foreground="#344054" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" /></StackPanel>
                <Button Grid.Column="2" Content="&#x9009;&#x62E9;&#x76EE;&#x5F55;" Click="BrowseDirectory_Click" Background="#EEF4FF" Foreground="#1D4ED8" />
            </Grid>
        </Border>

        <Border Style="{StaticResource PanelStyle}" Padding="20" Margin="0,16,0,0" Background="#FBFCFE">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold" Foreground="#172033" />
                        <TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" Foreground="#667085" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#x6682;&#x505C;" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" MinWidth="62" Background="#FFF4D6" Foreground="#92400E" Margin="0,0,8,0" />
                        <Button Content="&#x7EE7;&#x7EED;" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" MinWidth="62" Background="#E7F8EF" Foreground="#166534" Margin="0,0,8,0" />
                        <Button Content="&#x4E22;&#x5F03;" Command="{Binding DiscardCommand}" IsEnabled="{Binding CanDiscard}" MinWidth="62" Background="#FEECEC" Foreground="#B42318" Margin="0,0,12,0" />
                        <Button Content="&#x5F00;&#x59CB;&#x8F6C;&#x5B58;" Click="StartTransfer_Click" MinWidth="92" Background="#2563EB" Foreground="White" />
                    </StackPanel>
                </Grid>
            <ProgressBar Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="8" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelStyle}" Padding="18" Margin="0,16,0,0"><StackPanel><TextBlock Text="&#x6267;&#x884C;&#x8BB0;&#x5F55;" FontWeight="SemiBold" /><ListBox ItemsSource="{Binding Logs}" Height="128" Margin="0,12,0,0" Background="#F8FAFC" BorderThickness="0" Padding="10" /></StackPanel></Border>
    </StackPanel>
</UserControl>
