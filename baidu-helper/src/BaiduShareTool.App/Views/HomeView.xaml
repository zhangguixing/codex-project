<UserControl x:Class="BaiduShareTool.App.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="百度网盘分享链接生成工具" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="从一个目录开始，批量生成分享链接并导出 Excel。" Foreground="#667085" FontSize="14" Margin="0,8,0,28"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="登录状态" Foreground="#667085"/><TextBlock Text="{Binding LoginSession.StatusText}" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#111827"/><Style.Triggers><DataTrigger Binding="{Binding LoginSession.IsLoggedIn}" Value="True"><Setter Property="Foreground" Value="#087443"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="前往设置  →" Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#087443" Background="Transparent" HorizontalAlignment="Left" Padding="0,5"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="今日生成" Foreground="#667085"/><TextBlock Text="{Binding TodayGenerated}" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="条分享链接" Foreground="#667085" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Text="历史任务" Foreground="#667085"/><TextBlock Text="{Binding HistoryTaskCount}" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="次导出任务" Foreground="#667085" Margin="0,5,0,0"/></StackPanel></Border></Grid>
    <DockPanel Margin="0,14,0,0"><Button Content="退出当前登录" Command="{Binding LogoutCommand}" Foreground="#B42318" Background="Transparent" Padding="0,5"/></DockPanel>
    <Border Background="#EAF2FF" CornerRadius="10" Padding="22" Margin="0,22,0,0"><DockPanel><StackPanel><TextBlock Text="开始一个分享任务" FontSize="18" FontWeight="SemiBold" Foreground="#1D4ED8"/><TextBlock Text="工具会递归扫描文件并生成 Excel。" Foreground="#47658F" Margin="0,6,0,0"/></StackPanel><Button Content="开始任务  →" Command="{Binding DataContext.ShowTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" DockPanel.Dock="Right" Background="#2563EB" Foreground="White" Margin="20,0,0,0"/></DockPanel></Border>
    <TextBlock Text="最近活动" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,12"/><Border Style="{StaticResource PanelStyle}" Padding="14"><Grid><TextBlock Text="暂无活动记录" Foreground="#98A2B3" HorizontalAlignment="Center" Padding="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RecentActivities.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl ItemsSource="{Binding RecentActivities}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EEF2F6" BorderThickness="0,0,0,1" Padding="8,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LocalExportTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="#667085"/><TextBlock Grid.Column="1" Text="{Binding RootPath}" TextTrimming="CharacterEllipsis" Margin="12,0"/><TextBlock Grid.Column="2" Text="{Binding SuccessCount, StringFormat=成功 {0} 条}" Foreground="#16794A"/><TextBlock Grid.Column="2" Text="{Binding FailedCount, StringFormat=失败 {0} 条}" Foreground="#B42318" Margin="90,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
  </StackPanel>
</UserControl>
