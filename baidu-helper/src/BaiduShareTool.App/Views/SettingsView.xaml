<UserControl x:Class="BaiduShareTool.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="管理登录信息、导出行为和常用偏好" Foreground="#667085" Margin="0,7,0,22"/>
    <Border Style="{StaticResource PanelStyle}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="百度网盘登录" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="建议使用扫码登录，凭证会加密保存在本机。" Foreground="#667085" Margin="0,5,0,0"/></StackPanel><Button Content="扫码 / 网页登录" Click="LoginWithBrowser_Click" DockPanel.Dock="Right" Background="#2563EB" Foreground="White" Padding="16,9"/></DockPanel><TextBlock Grid.Row="1" Text="Cookie" Foreground="#475467" Margin="0,20,0,6"/><TextBox Grid.Row="2" Text="{Binding Cookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="38"/><TextBlock Grid.Row="3" Text="BDUSS" Foreground="#475467" Margin="0,14,0,6"/><TextBox Grid.Row="4" Text="{Binding Bduss, UpdateSourceTrigger=PropertyChanged}" MinHeight="38"/><Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="默认分享密码" Foreground="#475467"/><TextBlock Text="4 位字母或数字，用于所有新分享链接" Foreground="#98A2B3" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding SharePassword, UpdateSourceTrigger=PropertyChanged}" Height="38"/></Grid></Grid></Border>
    <Border Style="{StaticResource PanelStyle}" Padding="24" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="导出设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="默认导出位置" Foreground="#475467" Margin="0,18,0,6"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" MinHeight="38"/><Button Grid.Column="2" Content="浏览目录" Click="BrowseExportDirectory_Click" Background="#EEF4FF" Foreground="#1D4ED8"/></Grid><CheckBox Grid.Row="3" Content="导出完成后自动打开 Excel 文件" IsChecked="{Binding AutoOpen}" Margin="0,14,0,0"/></Grid></Border>
    <DockPanel Margin="0,18,0,10"><Button Content="保存全部设置" Command="{Binding SaveCommand}" Background="#2563EB" Foreground="White" Padding="18,10"/><TextBlock Text="{Binding SaveMessage}" Foreground="#087443" VerticalAlignment="Center" Margin="14,0,0,0"/></DockPanel>
  </StackPanel>
</UserControl>
