<Window x:Class="BaiduShareTool.App.BaiduBrowserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录百度网盘" Width="980" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0"><TextBlock Text="请在下方页面完成扫码或账号登录，登录完成后点击“使用当前登录状态”。" VerticalAlignment="Center" Foreground="#475569" /><Button Content="使用当前登录状态" Click="UseCurrentSession_Click" DockPanel.Dock="Right" Background="#2563EB" Foreground="White" Padding="14,8" /></DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" Source="https://pan.baidu.com/" />
    </Grid>
</Window>
