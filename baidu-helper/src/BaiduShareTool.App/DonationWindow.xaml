<Window x:Class="BaiduShareTool.App.DonationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="支持开发" Width="470" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F6F8FB">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="支持项目持续维护" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="如果这个工具对你有帮助，欢迎请作者喝杯咖啡。你的支持会用于后续功能开发和兼容性维护。" TextWrapping="Wrap" Foreground="#667085" Margin="0,10,0,18"/></StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="18" BorderBrush="#E7EAF0" BorderThickness="1"><Image Source="/BaiduShareTool.App;component/Resources/donation.jpg" Stretch="Uniform"/></Border>
        <TextBlock Grid.Row="2" Text="微信扫码支持 · 感谢你的认可" HorizontalAlignment="Center" Foreground="#087443" FontWeight="SemiBold" Margin="0,18,0,0"/>
