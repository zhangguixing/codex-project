<Window x:Class="BaiduShareTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BaiduShareTool.App.ViewModels"
        xmlns:views="clr-namespace:BaiduShareTool.App.Views"
        Title="Baidu Share" Width="1240" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Opacity="0" Loaded="MainWindow_Loaded" Icon="{StaticResource AppIcon}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomePageViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransferPageViewModel}"><views:TransferView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShareTaskPageViewModel}"><views:ShareTaskView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupportPageViewModel}"><views:SupportView /></DataTemplate>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D5D9E2" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" /><Setter Property="Margin" Value="0,3" />
            <Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#26324A" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8" /><Setter Property="BorderBrush" Value="#D7DDE8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="14" /></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,9" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#172033">
            <DockPanel Margin="18,24">
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="{StaticResource AppIcon}" Width="36" Height="36" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <TextBlock Text="BAIDU SHARE" Foreground="#8EA2C8" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="&#x7F51;&#x76D8;&#x5206;&#x4EAB;&#x5DE5;&#x5177;" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,28" />
                    <Button Content="&#x9996;&#x9875;" Style="{StaticResource NavButtonStyle}" Command="{Binding ShowHomeCommand}" />
                    <Button Content="&#x6279;&#x91CF;&#x8F6C;&#x5B58;" Style="{StaticResource NavButtonStyle}" Command="{Binding ShowTransferCommand}" />
                    <Button Content="&#x5206;&#x4EAB;&#x4EFB;&#x52A1;" Style="{StaticResource NavButtonStyle}" Command="{Binding ShowTaskCommand}" />
                    <Button Content="&#x5386;&#x53F2;&#x8BB0;&#x5F55;" Style="{StaticResource NavButtonStyle}" Command="{Binding ShowHistoryCommand}" />
                    <Button Content="&#x8BBE;&#x7F6E;" Style="{StaticResource NavButtonStyle}" Command="{Binding ShowSettingsCommand}" />
                    <Button Content="&#x652F;&#x6301;&#x4F5C;&#x8005;" Style="{StaticResource NavButtonStyle}" Command="{Binding ShowSupportCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom"><Separator Background="#303B54" Margin="0,0,0,14" /><TextBlock Text="&#x767E;&#x5EA6;&#x7F51;&#x76D8;&#x8FDE;&#x63A5;" Foreground="#C4CCDB" /><TextBlock Text="{Binding LoginSession.StatusText, StringFormat=v1.0.0 | {0}}" Foreground="#7F8BA3" Margin="0,5,0,0" /></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E7EAF0" BorderThickness="0,0,0,1"><DockPanel Margin="28,0"><TextBlock Text="{Binding CurrentTitle}" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="&#x5237;&#x65B0;" Command="{Binding RefreshPageCommand}" Background="Transparent" Foreground="#475569" Padding="8,4" Margin="0,0,8,0" /><TextBlock Text="{Binding RefreshMessage}" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,12,0" /><Border Background="#EAFBF2" CornerRadius="6" Padding="10,5"><TextBlock Text="{Binding LoginSession.StatusText}" Foreground="#087443" FontSize="12" /></Border></StackPanel></DockPanel></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28"><ContentControl Content="{Binding CurrentPage}" /></ScrollViewer>
        </Grid>
    </Grid>
</Window>
