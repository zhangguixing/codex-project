<Window x:Class="BaiduShareTool.App.BaiduDirectoryPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择百度网盘目录" Width="760" Height="600" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#F6F8FB">
    <Window.Resources><Style TargetType="Button"><Setter Property="Cursor" Value="Hand" /><Setter Property="Padding" Value="12,7" /><Setter Property="BorderThickness" Value="0" /></Style><Style TargetType="ListViewItem"><Setter Property="Padding" Value="12,10" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF4FF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCE9FF" /></Trigger></Style.Triggers></Style></Window.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel><StackPanel><TextBlock Text="选择网盘目录" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="可按 Ctrl/Shift 多选目录；双击进入下级目录" Foreground="#64748B" Margin="0,5,0,0" /></StackPanel><Button Content="↑  上一级" Click="Up_Click" DockPanel.Dock="Right" Background="#E8F0FF" Foreground="#1D4ED8" /></DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0"><DockPanel><TextBlock Text="当前位置" Foreground="#64748B" /><TextBlock x:Name="PathText" Text="/" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E293B" /></DockPanel></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10"><Grid><ListView x:Name="DirectoryList" SelectionMode="Extended" MouseDoubleClick="DirectoryList_DoubleClick"><ListView.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="📁" FontSize="20" Width="38" VerticalAlignment="Center" /><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B" /><TextBlock Text="{Binding Path}" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" /></StackPanel><TextBlock Text="双击进入" DockPanel.Dock="Right" Foreground="#64748B" VerticalAlignment="Center" /></DockPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="EmptyText" Text="此目录没有可进入的子文件夹" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" /></Grid></Border>
        <DockPanel Grid.Row="5"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#64748B" /><Button x:Name="SelectButton" Content="选择所选目录" Click="Select_Click" DockPanel.Dock="Right" Background="#2563EB" Foreground="White" FontWeight="SemiBold" IsEnabled="False" /></DockPanel>
    </Grid>
</Window>
