.dock-shell { position:fixed; left:0; right:0; bottom:0; z-index:1000; padding:0 24rpx calc(16rpx + env(safe-area-inset-bottom)); pointer-events:none; box-sizing:border-box; }
.dock { position:relative; height:112rpx; padding:10rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.78); border-radius:34rpx; background:rgba(255,255,255,.48); box-shadow:0 14rpx 38rpx rgba(37,38,41,.14),inset 0 1rpx 0 rgba(255,255,255,.92); -webkit-backdrop-filter:blur(28rpx) saturate(155%); backdrop-filter:blur(28rpx) saturate(155%); display:flex; align-items:center; justify-content:space-between; pointer-events:auto; box-sizing:border-box; }
.dock::before { position:absolute; left:22rpx; right:22rpx; top:0; height:1rpx; background:rgba(255,255,255,.95); content:""; }
.dock-item { position:relative; z-index:1; height:92rpx; min-width:0; flex:1; padding:8rpx 6rpx; border-radius:24rpx; color:#72747a; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; transition:transform .18s ease,background-color .18s ease,box-shadow .18s ease; box-sizing:border-box; }
.dock-icon { width:34rpx; height:34rpx; opacity:.58; }
.dock-label { font-size:20rpx; font-weight:800; line-height:26rpx; }
.dock-item.selected { background:rgba(218,244,156,.92); color:#213d2a; box-shadow:inset 0 1rpx 0 rgba(255,255,255,.88),0 7rpx 16rpx rgba(87,119,61,.18); transform:scale(1.05); }
.dock-item.selected .dock-icon { opacity:1; }
.dock-item.selected .dock-label { font-size:21rpx; }
.dock-item.primary { background:rgba(255,255,255,.34); color:#55575b; box-shadow:inset 0 1rpx 0 rgba(255,255,255,.7),0 5rpx 14rpx rgba(37,38,41,.06); }
.dock-item.primary .dock-icon { opacity:.76; }
.dock-item.primary.selected { background:linear-gradient(104deg,rgba(255,240,67,.96),rgba(207,239,139,.96)); color:#202124; }
.dock-item.primary.selected .dock-icon { opacity:1; }
.dock-item:active { opacity:.72; }
