<view class="page home-page">
  <view class="hero"><view class="hero-glow"></view><view class="hero-top"><view class="brand">桌游圈</view><view class="location" bindtap="chooseLocation">当前位置 · {{locationLabel}}⌄</view></view><view class="hero-copy"><view class="hero-title">今天，来一局</view><view class="hero-subtitle">发现同城真实桌游组局</view></view></view>
  <view class="quick-row"><view class="search"><text class="search-icon">⌕</text><input value="{{keyword}}" placeholder="搜索活动名称" confirm-type="search" bindinput="changeKeyword" bindconfirm="search" /><button class="search-button" bindtap="search">搜索</button></view><button class="create-shortcut" bindtap="createActivity">+ 发起组局</button></view>
  <view class="community-banner"><view><view class="banner-title">发起活动，遇见同好</view><view class="banner-note">完善活动信息，让更多玩家找到你</view></view><button bindtap="createActivity">去发布</button></view>
  <scroll-view scroll-x="true" class="filter-scroll" show-scrollbar="false"><view class="filter-row"><view class="filter {{!timeRange ? 'active' : ''}}" data-range="" bindtap="chooseTime">全部</view><view class="filter {{timeRange === 'today' ? 'active' : ''}}" data-range="today" bindtap="chooseTime">今天</view><view class="filter {{timeRange === 'tomorrow' ? 'active' : ''}}" data-range="tomorrow" bindtap="chooseTime">明天</view><view class="filter {{timeRange === 'weekend' ? 'active' : ''}}" data-range="weekend" bindtap="chooseTime">周末</view></view></scroll-view>
  <scroll-view scroll-x="true" class="type-scroll" show-scrollbar="false"><view class="type-list"><view class="chip {{!selectedType ? 'active' : ''}}" data-id="" bindtap="chooseType">全部类型</view><view wx:for="{{types}}" wx:key="id" class="chip {{selectedType === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseType">{{item.name}}</view></view></scroll-view>
  <view class="section-head"><view><view class="eyebrow">NEARBY PLAYERS</view><view class="section-title">附近组局</view></view><text class="section-action" bindtap="load">刷新</text></view>
  <view wx:if="{{loading}}" class="loading">正在寻找附近的桌游局...</view><block wx:else><activity-card wx:for="{{activities}}" wx:key="id" item="{{item}}" /><view wx:if="{{!activities.length}}" class="empty">附近暂时没有活动，来发起第一场吧。</view></block>
</view>
