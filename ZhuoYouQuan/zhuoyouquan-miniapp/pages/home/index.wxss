page { background: #f7f7f8; }.home-page { padding: 0 28rpx calc(148rpx + env(safe-area-inset-bottom)); color: #202124; }.hero { position: relative; height: 336rpx; margin: 0 -28rpx; padding: 62rpx 36rpx 0; overflow: hidden; background: linear-gradient(120deg,#fff36b,#ddf993 48%,#b6efd7); }.hero-glow { position:absolute; right:-70rpx; top:40rpx; width:230rpx; height:230rpx; border:28rpx solid rgba(255,255,255,.38); border-radius:50%; }.hero-top,.quick-row,.community-banner { display:flex; align-items:center; justify-content:space-between; position:relative; }.brand { font-size:54rpx; font-weight:900; }.location { padding:10rpx 16rpx; border-radius:24rpx; background:rgba(255,255,255,.55); font-size:24rpx; }.hero-copy { position:relative; margin-top:52rpx; }.hero-title { font-size:56rpx; font-weight:900; }.hero-subtitle { margin-top:8rpx; font-size:26rpx; }.quick-row { margin-top:-40rpx; gap:16rpx; }.search { height:84rpx; padding:0 28rpx; border-radius:18rpx; background:#fff; box-shadow:0 10rpx 26rpx rgba(41,42,44,.1); flex:1; color:#909399; display:flex; align-items:center; }.create-shortcut { height:84rpx; padding:0 24rpx; border-radius:18rpx; background:#242528; color:#fff; font-size:25rpx; font-weight:700; line-height:84rpx; }.community-banner { min-height:132rpx; padding:20rpx 24rpx; margin-top:26rpx; border-radius:20rpx; background:linear-gradient(100deg,#ffe624,#d7f58b); box-sizing:border-box; }.banner-title { font-size:31rpx; font-weight:800; }.banner-note { margin-top:5rpx; color:#5e601f; font-size:22rpx; }.community-banner button { padding:0 22rpx; border-radius:24rpx; background:#242528; color:#fff; font-size:23rpx; }.filter-scroll,.type-scroll { white-space:nowrap; }.filter-row,.type-list { display:inline-flex; padding:24rpx 0 4rpx; }.filter,.chip { min-width:100rpx; height:62rpx; margin-right:14rpx; padding:0 22rpx; border-radius:31rpx; background:#ececef; color:#68696d; font-size:25rpx; text-align:center; line-height:62rpx; }.filter.active,.chip.active { background:#252629; color:#fff; }.chip { border:1rpx solid #e7e7e9; background:#fff; }.section-head { margin:38rpx 0 18rpx; }.section-title { color:#202124; }.section-action { color:#383a3e; }.eyebrow { color:#81838a; }
