page { background:#f7f7f8; }.store-detail { padding:0 28rpx 36rpx; }.detail-nav { height:94rpx; display:grid; grid-template-columns:88rpx 1fr 88rpx; align-items:center; color:#232427; font-size:34rpx; font-weight:900; text-align:center; }.detail-nav button { width:64rpx; height:64rpx; margin:0; padding:0; border-radius:50%; background:#fff; color:#252629; font-size:48rpx; line-height:56rpx; }.store-hero { padding:36rpx 30rpx; border-radius:22rpx; background:linear-gradient(125deg,#ffd86a,#ffceb8); }.venue-kicker { color:#795741; font-size:22rpx; font-weight:800; }.venue-name { margin-top:14rpx; color:#292725; font-size:45rpx; font-weight:900; }.venue-city { margin-top:13rpx; color:#765c4a; font-size:24rpx; }.venue-card { margin-top:20rpx; padding:12rpx 24rpx 24rpx; border-radius:18rpx; background:#fff; }.venue-row { display:flex; gap:20rpx; padding:20rpx 0; border-bottom:1rpx solid #eeeef0; color:#4f5157; font-size:25rpx; line-height:1.5; }.venue-row text { width:76rpx; flex:none; color:#97999f; }.navigate-button { height:72rpx; margin:22rpx 0 0; border-radius:10rpx; background:#252629; color:#fff; font-size:26rpx; font-weight:700; line-height:72rpx; }
