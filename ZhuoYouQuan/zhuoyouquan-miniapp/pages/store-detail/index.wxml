<view class="page store-detail"><view class="detail-nav"><button bindtap="back">‹</button><view>门店详情</view><view></view></view><view wx:if="{{loading}}" class="loading">正在加载...</view><block wx:elif="{{store}}"><view class="store-hero"><view class="venue-kicker">合作桌游馆</view><view class="venue-name">{{store.name}}</view><view class="venue-city">{{store.city}} · {{store.businessHours || '营业时间待更新'}}</view></view><view class="venue-card"><view class="venue-row"><text>地址</text><view>{{store.address}}</view></view><view class="venue-row"><text>设施</text><view>{{store.facilities || '桌游桌、空调与饮品服务'}}</view></view><view class="venue-row"><text>停车</text><view>{{store.parkingAvailable ? '可停车' : '请咨询门店'}}</view></view><button class="navigate-button" bindtap="navigate">地图导航</button></view><view class="section-head"><view class="section-title">这里的活动</view></view><activity-card wx:for="{{activities}}" wx:key="id" item="{{item}}"/><view wx:if="{{!activities.length}}" class="empty">这家门店暂时没有公开活动。</view></block></view>
