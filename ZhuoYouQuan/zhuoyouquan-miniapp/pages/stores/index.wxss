page { background:#f7f7f8; }.stores-page { padding:0 28rpx 40rpx; }.stores-nav { height:94rpx; display:grid; grid-template-columns:88rpx 1fr 88rpx; align-items:center; color:#232427; font-size:34rpx; font-weight:900; text-align:center; }.stores-nav button { width:64rpx; height:64rpx; margin:0; padding:0; border-radius:50%; background:#fff; color:#252629; font-size:48rpx; line-height:56rpx; }.stores-hero { position:relative; overflow:hidden; min-height:250rpx; padding:30rpx; border-radius:22rpx; background:linear-gradient(125deg,#ffd86a,#ffd0b5); box-sizing:border-box; }.hero-orbit { position:absolute; right:-54rpx; top:-64rpx; width:224rpx; height:224rpx; border:22rpx solid rgba(255,255,255,.44); border-radius:50%; }.hero-label,.hero-title { position:relative; }.hero-label { color:#795741; font-size:21rpx; font-weight:800; }.hero-title { margin-top:18rpx; color:#2b2927; font-size:43rpx; font-weight:900; line-height:1.2; }.store-card { display:flex; align-items:center; gap:18rpx; margin-bottom:18rpx; padding:24rpx; border-radius:18rpx; background:#fff; box-shadow:0 8rpx 20rpx rgba(34,35,38,.06); }.store-card:active { opacity:.72; }.store-mark { width:66rpx; height:66rpx; flex:none; border-radius:16rpx; background:#252629; color:#ffd86a; display:flex; align-items:center; justify-content:center; font-size:29rpx; font-weight:900; }.store-copy { flex:1; min-width:0; }.store-name { overflow:hidden; color:#252629; font-size:30rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.store-address,.store-meta { overflow:hidden; margin-top:7rpx; color:#898b91; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }.store-meta { color:#ad7a3d; }.store-arrow { color:#777980; font-size:42rpx; }
