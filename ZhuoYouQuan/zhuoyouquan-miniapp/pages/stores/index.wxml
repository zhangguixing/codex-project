<view class="page stores-page"><view class="stores-nav"><button bindtap="back">‹</button><view>合作桌游馆</view><view></view></view><view class="stores-hero"><view class="hero-orbit"></view><view class="hero-label">TABLETOP VENUES</view><view class="hero-title">选一张好桌子<br/>再开一场好局</view></view><view class="section-head"><view class="section-title">附近门店</view><text class="section-action" bindtap="load">刷新</text></view><view wx:if="{{loading}}" class="loading">正在加载门店...</view><block wx:else><view wx:for="{{stores}}" wx:key="id" class="store-card" bindtap="open" data-id="{{item.id}}"><view class="store-mark">馆</view><view class="store-copy"><view class="store-name">{{item.name}}</view><view class="store-address">{{item.address}}</view><view class="store-meta">{{item.businessHours || '营业时间待更新'}}{{item.parkingAvailable ? ' · 可停车' : ''}}</view></view><text class="store-arrow">›</text></view><view wx:if="{{!stores.length}}" class="empty">暂时没有已入驻的桌游馆。</view></block></view>
