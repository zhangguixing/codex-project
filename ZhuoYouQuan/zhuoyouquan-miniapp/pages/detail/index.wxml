<view class="page">
  <view class="detail-nav"><button class="detail-back" bindtap="back" aria-label="返回上一页">‹</button><view class="detail-nav-title">活动详情</view><view class="detail-nav-placeholder"></view></view>
  <view wx:if="{{loading}}" class="loading">正在加载活动详情...</view>
  <block wx:elif="{{item}}">
    <view class="masthead"><image wx:if="{{item.coverUrl}}" class="masthead-cover" src="{{item.coverUrl}}" mode="aspectFill"/><view wx:else class="masthead-cover default-cover {{item.coverTheme}}"></view><view class="pattern"></view><view class="type-badge">{{item.gameType || '桌游'}}</view><view class="title">{{item.title}}</view><view class="city">{{item.city || '同城'}} · {{item.newbieFriendly ? '新手友好' : '进阶局'}}</view></view><view class="share-tools"><button open-type="share">邀请好友</button><button bindtap="openPoster" loading="{{posterGenerating}}">生成分享卡片</button></view>
    <view class="details">
      <view class="detail-row"><text>时间</text><b>{{item.displayTime || '时间待定'}}</b></view>
      <view class="detail-row"><text>预计时长</text><b>{{item.durationMinutes ? '约 ' + item.durationMinutes + ' 分钟' : '时长待定'}}</b></view>
      <view class="detail-row location-row" bindtap="navigateToLocation" role="button" aria-label="打开地图导航"><text>地点</text><view class="location-value"><b>{{item.storeName || item.address || '地点待定'}}</b><text class="navigate-action">导航</text></view></view>
      <view class="detail-row"><text>费用</text><b class="accent">{{item.fee ? '¥' + item.fee + ' / 人' : '免费'}}</b></view>
      <view class="detail-row"><text>名额</text><b>{{item.joinedPeople || 0}} / {{item.maxPeople}} 人</b></view>
    </view>
    <view wx:if="{{item.durationMinutes || item.difficulty || item.language}}" class="game-meta"><text wx:if="{{item.durationMinutes}}">约 {{item.durationMinutes}} 分钟</text><text wx:if="{{item.difficulty}}">{{item.difficulty}}</text><text wx:if="{{item.language}}">{{item.language}}</text><text wx:if="{{item.teachingProvided}}">含新手教学</text><text wx:if="{{item.bringGame}}">发起人带游戏</text></view>
    <view class="section-head"><view class="section-title">活动说明</view></view><view class="description">{{item.description || '暂未填写活动说明'}}</view>
    <view class="section-head"><view class="section-title">发起人</view></view>
    <view class="organizer"><view class="avatar">桌</view><view class="organizer-info"><view class="organizer-name">{{item.organizer ? item.organizer.nickname : '桌游玩家'}}</view><view class="muted">{{item.organizer && item.organizer.gameLevel ? item.organizer.gameLevel : '欢迎一起玩'}}</view></view><button wx:if="{{item.status === 'ENDED' && item.joined && !isOwner}}" class="message-button" bindtap="openReview">评价</button><button wx:elif="{{!isOwner}}" class="message-button" bindtap="openMessage">留言</button><button wx:if="{{!isOwner}}" class="safety-button" bindtap="openSafety">•••</button></view>
    <block wx:if="{{isOwner || item.joined}}"><view class="section-head"><view class="section-title">本局讨论<text wx:if="{{chatMessageTotal}}" class="chat-total">{{chatMessageTotal}}</text></view><text class="section-action" bindtap="load">刷新</text></view><view class="participants chat-list"><view wx:for="{{chats}}" wx:key="id" class="chat-floor"><view class="chat-floor-main"><view class="participant-avatar">{{item.user.nickname ? item.user.nickname.slice(0, 1) : '聊'}}</view><view class="chat-body"><view class="chat-meta"><text class="chat-name">{{item.user.nickname || '玩家'}}</text><text class="chat-number">#{{item.floor}}</text></view><view class="chat-content">{{item.content}}</view><text class="chat-reply-action" data-chat="{{item}}" bindtap="replyChat">回复</text></view></view><view wx:if="{{item.replyCount}}" class="chat-replies"><view wx:if="{{!item.repliesExpanded}}" class="chat-reply-toggle" data-id="{{item.id}}" bindtap="toggleReplies"><text>展开 {{item.replyCount}} 条回复</text><text>⌄</text></view><block wx:else><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="chat-reply"><view class="chat-reply-copy"><text class="chat-name">{{reply.user.nickname || '玩家'}}</text><text wx:if="{{reply.replyToUser}}" class="chat-reply-to"> 回复 @{{reply.replyToUser.nickname || '玩家'}}</text><text>：{{reply.content}}</text></view><text class="chat-reply-action" data-chat="{{reply}}" bindtap="replyChat">回复</text></view><view class="chat-reply-toggle" data-id="{{item.id}}" bindtap="toggleReplies"><text>收起回复</text><text>⌃</text></view></block></view></view><view wx:if="{{!chats.length}}" class="muted">还没有消息，先确认规则、到店时间或拼车安排吧。</view><view wx:if="{{chatTotal > 6}}" class="chat-collapse" bindtap="toggleChatCollapse"><text>{{chatToggleText}}</text><text class="chat-collapse-arrow">{{chatExpanded ? '⌃' : '⌄'}}</text></view><view wx:if="{{replyTarget}}" class="chat-replying"><text>回复 @{{replyTarget.user.nickname || '玩家'}}</text><text class="chat-reply-cancel" bindtap="cancelReply">取消</text></view><view class="chat-compose"><input value="{{chatContent}}" placeholder="{{replyTarget ? '写下你的回复…' : '聊聊规则、到店时间或拼车…'}}" maxlength="500" bindinput="changeChat" /><button loading="{{chatSending}}" disabled="{{chatSending}}" bindtap="sendChat">发送</button></view></view></block>
    <block wx:if="{{isOwner}}"><view class="section-head"><view class="section-title">发起人工作台</view><text class="section-action" bindtap="openBroadcast">群发通知</text></view><view class="workbench"><view><text>{{item.joinedPeople || 0}}</text><view>已报名</view></view><view><text>{{item.waitlistCount || 0}}</text><view>候补中</view></view><view><text>{{item.checkedInParticipantIds.length || 0}}</text><view>已到场</view></view></view><view class="section-head"><view class="section-title">报名与签到</view></view><view class="participants"><view wx:for="{{item.participants}}" wx:key="id" class="participant"><view class="participant-avatar">{{item.nickname ? item.nickname.slice(0, 1) : '玩'}}</view><view class="participant-name">{{item.nickname || '桌游玩家'}}</view><button class="checkin-button {{item.checkedIn ? 'checked' : ''}}" disabled="{{item.checkedIn}}" data-participant="{{item}}" bindtap="checkIn">{{item.checkedIn ? '已到场' : '确认到场'}}</button></view><view wx:if="{{!item.participants.length}}" class="muted">暂时还没有玩家报名</view></view></block>
    <view class="bottom-space"></view><view class="join-bar"><button wx:if="{{isOwner}}" class="primary-button {{item.status === 'ENDED' ? 'disabled' : ''}}" disabled="{{item.status === 'ENDED'}}" bindtap="edit">{{item.status === 'ENDED' ? '活动已结束' : '编辑活动'}}</button><button wx:elif="{{item.joined || item.waitlisted}}" class="primary-button cancel-button" loading="{{joining}}" disabled="{{joining || item.status === 'ENDED'}}" bindtap="cancelJoin">{{item.status === 'ENDED' ? '活动已结束' : (item.waitlisted ? '退出候补' : '取消报名')}}</button><button wx:else class="primary-button {{item.status === 'ENDED' ? 'disabled' : ''}}" loading="{{joining}}" disabled="{{item.status === 'ENDED' || joining}}" bindtap="join">{{item.status === 'ENDED' ? '活动已结束' : (item.status === 'FULL' ? '加入候补' : '立即报名')}}</button></view>
    <view wx:if="{{messageVisible}}" class="message-mask" catchtap="closeMessage">
      <view class="message-sheet" catchtap="noop">
        <view class="message-sheet-title">给发起人留言</view>
        <textarea class="message-input" value="{{messageContent}}" bindinput="changeMessage" maxlength="500" placeholder="说说你想了解的内容..." auto-focus />
        <view class="message-actions"><button class="message-cancel" bindtap="closeMessage">取消</button><button class="message-send" loading="{{sendingMessage}}" disabled="{{sendingMessage}}" bindtap="sendMessage">发送</button></view>
      </view>
    </view>
    <view wx:if="{{safetyVisible}}" class="message-mask" catchtap="closeSafety"><view class="message-sheet" catchtap="noop"><view class="message-sheet-title">安全与反馈</view><textarea class="message-input" value="{{safetyReason}}" bindinput="changeSafety" maxlength="500" placeholder="描述活动中遇到的问题"/><view class="message-actions"><button class="message-cancel" bindtap="blockOrganizer">拉黑发起人</button><button class="message-send" bindtap="reportActivity">举报活动</button></view></view></view>
    <view wx:if="{{reviewVisible}}" class="message-mask" catchtap="closeReview"><view class="message-sheet" catchtap="noop"><view class="message-sheet-title">评价本次组局</view><picker mode="selector" range="{{['1 分','2 分','3 分','4 分','5 分']}}" value="{{reviewScore - 1}}" bindchange="changeReviewScore"><view class="score-picker">综合评分 {{reviewScore}} / 5</view></picker><textarea class="message-input" value="{{reviewContent}}" bindinput="changeReview" maxlength="500" placeholder="写下这次活动的真实体验（选填）"/><view class="message-actions"><button class="message-cancel" bindtap="closeReview">取消</button><button class="message-send" bindtap="submitReview">提交评价</button></view></view></view>
    <view wx:if="{{broadcastVisible}}" class="message-mask" catchtap="closeBroadcast"><view class="message-sheet" catchtap="noop"><view class="message-sheet-title">群发活动通知</view><textarea class="message-input" value="{{broadcastContent}}" bindinput="changeBroadcast" maxlength="500" placeholder="例如：请提前十分钟到店，活动规则见群聊"/><view class="message-actions"><button class="message-cancel" bindtap="closeBroadcast">取消</button><button class="message-send" loading="{{broadcasting}}" disabled="{{broadcasting}}" bindtap="sendBroadcast">发送</button></view></view></view><view wx:if="{{shareVisible}}" class="message-mask" catchtap="closePoster"><view class="message-sheet share-sheet" catchtap="noop"><view class="message-sheet-title">活动分享卡片</view><image class="share-preview" src="{{shareImagePath}}" mode="widthFix"/><view class="message-actions"><button class="message-cancel" bindtap="closePoster">关闭</button><button class="message-send" bindtap="savePoster">保存图片</button></view></view></view><canvas canvas-id="shareCanvas" class="share-canvas" width="750" height="1040"></canvas>
  </block>
</view>
