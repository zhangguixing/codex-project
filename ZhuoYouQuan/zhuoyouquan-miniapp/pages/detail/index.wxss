.detail-nav { height:88rpx; margin-bottom:14rpx; display:flex; align-items:center; justify-content:space-between; }.detail-nav-title { flex:1; color:#202124; font-size:40rpx; font-weight:900; letter-spacing:2rpx; text-align:center; text-shadow:0 2rpx 0 rgba(255,255,255,.92),0 5rpx 12rpx rgba(37,38,41,.08); }.detail-back,.detail-nav-placeholder { width:88rpx; height:88rpx; min-width:88rpx; padding:0; border:0; border-radius:44rpx; box-sizing:border-box; }.detail-back { background:#fff; color:#202124; font-size:58rpx; font-weight:400; line-height:76rpx; box-shadow:0 4rpx 12rpx rgba(53,62,47,.07); }.detail-back::after { border:0; }.detail-back:active { background:#eeeeef; }.detail-nav-placeholder { visibility:hidden; }
.masthead { position:relative; overflow:hidden; min-height:264rpx; padding:34rpx; border-radius:24rpx; background:linear-gradient(125deg,#fff24b,#d5f48e); box-sizing:border-box; }.pattern { position:absolute; right:-48rpx; top:-72rpx; width:290rpx; height:290rpx; border:24rpx solid rgba(255,255,255,.5); border-radius:50%; }.type-badge { position:relative; display:inline-block; padding:8rpx 14rpx; border-radius:9rpx; background:#252629; color:#fff; font-size:21rpx; font-weight:700; }.title { position:relative; margin-top:18rpx; color:#222326; font-size:46rpx; font-weight:900; line-height:1.25; }.city { position:relative; margin-top:16rpx; color:#585b38; font-size:25rpx; }.details,.organizer,.participants { margin-top:22rpx; padding:8rpx 26rpx; border-radius:20rpx; background:#fff; }.detail-row { min-height:88rpx; border-bottom:1rpx solid #eeeef0; display:flex; align-items:center; justify-content:space-between; gap:18rpx; }.detail-row:last-child,.participant:last-child { border:0; }.detail-row text { color:#91939a; }.detail-row b { color:#252629; text-align:right; font-size:27rpx; }.accent { color:#eb5c35!important; }.description { color:#55575d; line-height:1.8; white-space:pre-wrap; }.organizer,.participant { display:flex; align-items:center; gap:16rpx; padding:24rpx; }.avatar,.participant-avatar { width:66rpx; height:66rpx; border-radius:50%; background:#252629; color:#fff; display:flex; align-items:center; justify-content:center; font-size:30rpx; font-weight:800; }.organizer-name { font-size:29rpx; font-weight:800; }.participant { min-height:84rpx; padding:16rpx 0; border-bottom:1rpx solid #eeeef0; color:#252629; }.participant-avatar { width:52rpx; height:52rpx; background:#f07a55; font-size:24rpx; }.muted { color:#94969d; font-size:23rpx; }.bottom-space { height:118rpx; }.join-bar { position:fixed; left:0; right:0; bottom:0; padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.96); }.disabled { opacity:.5; }
