.page { padding-top:0; }.message-hero { position:relative; overflow:hidden; margin:0 -28rpx; padding:calc(12rpx + env(safe-area-inset-top)) 28rpx 34rpx; background:linear-gradient(118deg,#fff459,#d7f593); }.message-hero .top-orbit { position:absolute; right:-40rpx; top:-70rpx; width:200rpx; height:200rpx; border:22rpx solid rgba(255,255,255,.42); border-radius:50%; }.message-hero .eyebrow,.message-hero .message-title,.hero-note { position:relative; }.message-hero .eyebrow { margin-top:10rpx; color:#63653d; }.message-title { margin-top:4rpx; color:#222326; font-size:50rpx; font-weight:900; }.hero-note { margin-top:8rpx; color:#63653d; font-size:25rpx; }.message-item { display:flex; align-items:center; gap:18rpx; min-height:112rpx; padding:22rpx 28rpx; margin-top:20rpx; border-radius:18rpx; background:#fff; }.message-item:active { background:#f3f4f5; }.notice-icon { width:70rpx; height:70rpx; flex:none; border-radius:18rpx; background:#fff14c; color:#222326; display:flex; align-items:center; justify-content:center; font-weight:900; }.message-content { min-width:0; flex:1; }.notice-title { overflow:hidden; margin-bottom:6rpx; color:#252629; font-size:30rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.message-text { overflow:hidden; color:#7d7f85; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }.message-arrow { color:#9a9ba0; font-size:42rpx; }.muted { font-size:24rpx; }
