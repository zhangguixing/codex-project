.page { padding-top:0; }.message-hero { position:relative; overflow:hidden; margin:0 -28rpx; padding:calc(12rpx + env(safe-area-inset-top)) 28rpx 34rpx; background:linear-gradient(118deg,#fff459,#d7f593); }.message-hero .top-orbit { position:absolute; right:-40rpx; top:-70rpx; width:200rpx; height:200rpx; border:22rpx solid rgba(255,255,255,.42); border-radius:50%; }.message-hero .eyebrow,.message-hero .message-title,.hero-note { position:relative; }.message-hero .eyebrow { margin-top:10rpx; color:#63653d; }.message-title { margin-top:4rpx; color:#222326; font-size:50rpx; font-weight:900; }.hero-note { margin-top:8rpx; color:#63653d; font-size:25rpx; }.notice { display:flex; align-items:center; gap:18rpx; padding:28rpx; margin-top:30rpx; border-radius:22rpx; background:#fff; }.notice-icon { width:70rpx; height:70rpx; border-radius:18rpx; background:#fff14c; color:#222326; display:flex; align-items:center; justify-content:center; font-weight:900; }.notice-title { margin-bottom:6rpx; font-size:30rpx; font-weight:800; }.muted { font-size:24rpx; }
