<view class="page"><view class="message-hero"><view class="top-orbit"></view><view class="page-tab-title">消息</view><view class="eyebrow">INBOX</view><view class="message-title">通知与动态</view><view class="hero-note">活动留言和报名提醒会在这里出现</view></view><view wx:if="{{loading}}" class="loading">正在加载消息...</view><block wx:else><view wx:for="{{messages}}" wx:key="id" class="message-item" bindtap="openActivity" data-id="{{item.targetId}}"><view class="notice-icon">言</view><view class="message-content"><view class="notice-title">{{item.title}}</view><view class="message-text">{{item.content}}</view></view><text class="message-arrow">›</text></view><view wx:if="{{!messages.length}}" class="empty">暂时没有新消息</view></block></view>
