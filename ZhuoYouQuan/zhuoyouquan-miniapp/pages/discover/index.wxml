<view class="page">
  <view class="page-tab-title">发现</view><view class="eyebrow">EXPLORE THE TABLE</view><view class="page-title">发现新玩法</view>
  <view class="feature"><view class="top-orbit"></view><view class="feature-label">本周主题</view><view class="feature-title">狼人杀<br/>新手入门局</view><view class="feature-note">从一张角色牌开始认识同桌的人</view><view class="feature-card">◈</view></view><view class="venue-entry" bindtap="openStores"><view><view class="venue-entry-title">合作桌游馆</view><view class="venue-entry-note">查看设施、停车与门店活动</view></view><text>›</text></view>
  <view class="section-head"><view class="section-title">最新活动</view><view class="discover-actions"><text class="section-action" bindtap="toggleFilters">筛选</text><text class="section-action" bindtap="load">刷新</text></view></view>
  <view wx:if="{{filtersOpen}}" class="filter-panel"><view class="filter-label">日期</view><view class="filter-row"><text data-field="timeRange" data-value="today" bindtap="setFilter" class="filter-chip {{filters.timeRange === 'today' ? 'active' : ''}}">今天</text><text data-field="timeRange" data-value="tomorrow" bindtap="setFilter" class="filter-chip {{filters.timeRange === 'tomorrow' ? 'active' : ''}}">明天</text><text data-field="timeRange" data-value="weekend" bindtap="setFilter" class="filter-chip {{filters.timeRange === 'weekend' ? 'active' : ''}}">周末</text></view><view class="filter-label">难度与偏好</view><view class="filter-row"><text data-field="difficulty" data-value="轻松" bindtap="setFilter" class="filter-chip {{filters.difficulty === '轻松' ? 'active' : ''}}">轻松</text><text data-field="difficulty" data-value="进阶" bindtap="setFilter" class="filter-chip {{filters.difficulty === '进阶' ? 'active' : ''}}">进阶</text><text data-field="difficulty" data-value="硬核" bindtap="setFilter" class="filter-chip {{filters.difficulty === '硬核' ? 'active' : ''}}">硬核</text><text data-field="newbieFriendly" data-value="true" bindtap="setFilter" class="filter-chip {{filters.newbieFriendly !== null ? 'active' : ''}}">新手友好</text></view><view class="filter-inputs"><input type="digit" data-field="maxFee" bindinput="changeFilter" value="{{filters.maxFee}}" placeholder="费用上限"/><input type="number" data-field="minSlots" bindinput="changeFilter" value="{{filters.minSlots}}" placeholder="至少空位"/></view><view class="filter-footer"><text bindtap="resetFilters">重置</text><button bindtap="load">应用筛选</button></view></view>
  <view wx:if="{{loading}}" class="loading">正在加载...</view>
  <block wx:else>
    <activity-card wx:for="{{activities}}" wx:key="id" item="{{item}}" />
    <view wx:if="{{!activities.length}}" class="empty">这里很安静，先去附近看看吧。</view>
  </block>
</view>
