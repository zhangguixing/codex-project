.page-tab-title { margin-bottom:12rpx; }.eyebrow { margin-top:8rpx; }.page-title { margin-top:4rpx; color:#222326; font-size:50rpx; font-weight:900; }.feature { position:relative; overflow:hidden; min-height:264rpx; padding:30rpx; margin-top:28rpx; border-radius:24rpx; background:linear-gradient(120deg,#fff24a,#d8f48c); box-sizing:border-box; }.feature .top-orbit { position:absolute; right:-46rpx; top:-82rpx; width:206rpx; height:206rpx; border:22rpx solid rgba(255,255,255,.42); border-radius:50%; }.feature-label,.feature-title,.feature-note { position:relative; }.feature-label { color:#55552c; font-size:22rpx; font-weight:800; }.feature-title { margin-top:10rpx; color:#222326; font-size:44rpx; font-weight:900; line-height:1.18; }.feature-note { margin-top:16rpx; color:#5f623b; font-size:23rpx; }.feature-card { position:absolute; right:34rpx; top:40rpx; width:108rpx; height:132rpx; border-radius:22rpx; background:#252629; color:#fff35d; display:flex; align-items:center; justify-content:center; font-size:48rpx; transform:rotate(10deg); }
.discover-actions { display:flex; gap:20rpx; }.filter-panel { margin:0 0 24rpx; padding:24rpx; border-radius:18rpx; background:#fff; box-shadow:0 8rpx 18rpx rgba(34,35,38,.06); }.filter-label { margin:0 0 12rpx; color:#6d6f75; font-size:22rpx; font-weight:800; }.filter-label:not(:first-child) { margin-top:22rpx; }.filter-row { display:flex; flex-wrap:wrap; gap:12rpx; }.filter-chip { min-height:52rpx; padding:0 16rpx; border-radius:8rpx; background:#f2f3f5; color:#676970; font-size:23rpx; line-height:52rpx; }.filter-chip.active { background:#252629; color:#fff35d; }.filter-inputs { display:flex; gap:14rpx; margin-top:22rpx; }.filter-inputs input { min-width:0; flex:1; height:66rpx; padding:0 16rpx; border-radius:9rpx; background:#f3f5f7; color:#252629; font-size:24rpx; box-sizing:border-box; }.filter-footer { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; color:#777980; font-size:24rpx; }.filter-footer button { width:142rpx; height:62rpx; margin:0; padding:0; border-radius:9rpx; background:#252629; color:#fff; font-size:24rpx; line-height:62rpx; }
.venue-entry { display:flex; align-items:center; justify-content:space-between; margin-top:18rpx; padding:22rpx 26rpx; border-radius:16rpx; background:#fff4e8; color:#6d4d32; }.venue-entry:active { opacity:.74; }.venue-entry-title { font-size:28rpx; font-weight:800; }.venue-entry-note { margin-top:5rpx; color:#a57854; font-size:22rpx; }.venue-entry text { font-size:42rpx; }
