page { background:#f7f7f8; }.profile-page { padding:0 28rpx calc(148rpx + env(safe-area-inset-bottom)); }.profile-hero { position:relative; height:258rpx; margin:0 -28rpx; padding:calc(12rpx + env(safe-area-inset-top)) 28rpx 0; overflow:hidden; background:linear-gradient(120deg,#fff35c,#dff69a 57%,#c5efd9); box-sizing:border-box; }.profile-orbit { position:absolute; right:-48rpx; top:20rpx; width:218rpx; height:218rpx; border:26rpx solid rgba(255,255,255,.42); border-radius:50%; }.profile-hero .page-tab-title { position:relative; }.hero-kicker { position:relative; margin-top:4rpx; color:#62643d; font-size:21rpx; font-weight:700; letter-spacing:2rpx; text-align:center; }.profile-card { position:relative; z-index:1; padding:30rpx; margin-top:-46rpx; border-radius:26rpx; background:#fff; box-shadow:0 18rpx 34rpx rgba(40,41,44,.12); box-sizing:border-box; }.profile-main { display:flex; align-items:center; gap:20rpx; }.profile-avatar,.guest-avatar { width:104rpx; height:104rpx; border-radius:50%; background:#252629; color:#fff35b; display:flex; align-items:center; justify-content:center; font-size:48rpx; font-weight:900; }.profile-name,.guest-title { color:#242529; font-size:40rpx; font-weight:900; }.profile-meta,.guest-note { margin-top:7rpx; color:#92949a; font-size:23rpx; }.stats,.guest-stats { display:grid; grid-template-columns:repeat(3,1fr); margin-top:30rpx; padding-top:24rpx; border-top:1rpx solid #eeeef0; text-align:center; }.stats text,.guest-stats text { color:#232427; font-size:34rpx; font-weight:900; }.stats view view,.guest-stats view view { margin-top:5rpx; color:#999ba1; font-size:21rpx; }.guest-card { text-align:left; }.guest-card:active { opacity:.8; }.guest-copy { flex:1; }.guest-arrow { position:absolute; right:30rpx; top:50rpx; color:#252629; font-size:52rpx; }.login-cta { height:76rpx; margin-top:26rpx; border-radius:14rpx; background:#252629; color:#fff; font-size:27rpx; font-weight:800; text-align:center; line-height:76rpx; }.section-head { margin-top:44rpx; }
