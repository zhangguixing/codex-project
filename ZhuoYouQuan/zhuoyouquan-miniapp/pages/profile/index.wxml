<view class="page profile-page">
  <view class="profile-hero"><view class="profile-orbit"></view><view class="page-tab-title">我的</view><view class="hero-kicker">TABLETOP PROFILE</view></view>
  <view wx:if="{{loading}}" class="loading">正在整理你的桌游档案...</view>
  <button wx:elif="{{!user}}" class="profile-card guest-card" loading="{{loggingIn}}" bindtap="login"><view class="guest-avatar">桌</view><view class="guest-copy"><view class="guest-title">登录桌游圈</view><view class="guest-note">微信授权后，管理你的组局与报名</view></view><view class="guest-arrow">›</view><view class="guest-stats"><view><text>--</text><view>发起活动</view></view><view><text>--</text><view>参与活动</view></view><view><text>--</text><view>信用积分</view></view></view><view class="login-cta">微信一键登录</view></button>
  <block wx:elif="{{user}}"><view class="profile-card"><view class="profile-main"><view class="profile-avatar">{{user.nickname ? user.nickname.slice(0, 1) : '桌'}}</view><view><view class="profile-name">{{user.nickname || '桌游玩家'}}</view><view class="profile-meta">{{user.city || '完善城市信息，发现附近组局'}}</view></view></view><view class="stats"><view><text>{{activities.length}}</text><view>发起活动</view></view><view><text>{{user.creditScore || 100}}</text><view>信用积分</view></view><view><text>{{user.gameLevel || '新手'}}</text><view>玩家等级</view></view></view></view><view class="section-head"><view><view class="eyebrow">MY SESSIONS</view><view class="section-title">我发起的活动</view></view></view><activity-card wx:for="{{activities}}" wx:key="id" item="{{item}}" show-end-action="{{item.status === 'OPEN' || item.status === 'FULL'}}" ending="{{endingId === item.id}}" bind:end="confirmEnd" /><view wx:if="{{!activities.length}}" class="empty">还没有发起活动，去开一局吧。</view></block>
</view>
