page { background:#f7f7f8; }.page { padding-top:0; }.create-hero { margin:0 -28rpx; padding:50rpx 28rpx 38rpx; background:linear-gradient(118deg,#fff35b,#def69a 58%,#c5efd9); }.eyebrow { color:#57592f; }.page-title { margin-top:8rpx; color:#202124; font-size:52rpx; font-weight:900; }.lead { margin-top:8rpx; color:#61633e; font-size:26rpx; }.form { margin-top:26rpx; }.form-group { position:relative; padding:22rpx 22rpx 4rpx; margin-bottom:20rpx; border-radius:22rpx; background:#fff; box-shadow:0 8rpx 20rpx rgba(39,40,42,.04); }.form-group::before { position:absolute; left:0; top:26rpx; bottom:26rpx; width:6rpx; border-radius:0 6rpx 6rpx 0; content:""; }.group-basic::before { background:#f2c94c; }.group-time::before { background:#55b5f4; }.group-fee::before { background:#f17d55; }.group-place::before { background:#7acb8a; }.group-description::before { background:#ad8ae8; }.group-title { padding-left:12rpx; color:#252629; font-size:30rpx; font-weight:900; }.field { padding:20rpx 12rpx; border-bottom:1rpx solid #f0f0f2; }.field:last-child { border:0; }.label { margin-bottom:10rpx; color:#777980; font-size:23rpx; font-weight:700; }.field input,.picker-value,.field textarea { width:100%; min-height:80rpx; padding:16rpx 18rpx; border-radius:14rpx; border:0; background:#f5f6f8; color:#242529; box-sizing:border-box; font-size:28rpx; }.picker-value { display:flex; align-items:center; justify-content:space-between; }.picker-value text,.location-action>text { color:#3b3c40; }.placeholder { color:#b3b5ba; }.field textarea { min-height:190rpx; }.location-action { min-height:86rpx; padding:14rpx 18rpx; border-radius:14rpx; background:#eef8ef; display:flex; align-items:center; justify-content:space-between; gap:16rpx; }.location-title { color:#2b5533; font-size:28rpx; font-weight:800; }.location-address { margin-top:4rpx; color:#7d9b83; font-size:23rpx; }.split { display:flex; gap:16rpx; }.half { flex:1; min-width:0; }.half input { text-align:center; }.switch-row { padding:24rpx 26rpx; margin:0 0 28rpx; border-radius:20rpx; background:#252629; color:#fff; display:flex; align-items:center; justify-content:space-between; }.switch-title { font-size:28rpx; font-weight:800; }.switch-desc { margin-top:4rpx; color:#c8c9cc; font-size:23rpx; }.disabled { opacity:.45; }
.switch-row { background:#eaf8d8; color:#29452f; }.switch-desc { color:#6b8a70; }.primary-button { background:linear-gradient(100deg,#ffe72c,#d6f58b); color:#252629; box-shadow:0 12rpx 22rpx rgba(203,220,78,.28); }.primary-button:active { background:#d5ef82; }
.page { padding-top:0; }.create-hero { padding-top:calc(12rpx + env(safe-area-inset-top)); }
.edit-nav { height:88rpx; display:flex; align-items:center; justify-content:space-between; color:#202124; }
.edit-nav-title { flex:1; color:#202124; font-size:40rpx; font-weight:900; letter-spacing:2rpx; text-align:center; text-shadow:0 2rpx 0 rgba(255,255,255,.82); }
.back-button,.nav-placeholder { width:88rpx; height:88rpx; min-width:88rpx; padding:0; border:0; border-radius:44rpx; box-sizing:border-box; }
.back-button { background:rgba(255,255,255,.72); color:#202124; font-size:58rpx; font-weight:400; line-height:76rpx; text-align:center; box-shadow:0 4rpx 12rpx rgba(53,62,47,.08); }
.back-button::after { border:0; }
.back-button:active { background:rgba(255,255,255,.42); opacity:1; }
.nav-placeholder { visibility:hidden; }
