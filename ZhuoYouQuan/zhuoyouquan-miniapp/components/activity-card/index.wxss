.card { position:relative; overflow:hidden; padding:26rpx; margin-bottom:20rpx; border-radius:22rpx; background:#fff; box-shadow:0 12rpx 28rpx rgba(34,35,38,.07); }.card:active { opacity:.76; }.topline,.footer { display:flex; align-items:center; }.game-mark { width:70rpx; height:70rpx; margin-right:18rpx; border-radius:18rpx; background:#fff14c; color:#222326; display:flex; align-items:center; justify-content:center; font-size:32rpx; font-weight:900; }.title-group { flex:1; min-width:0; }.game-type { color:#878991; font-size:21rpx; font-weight:700; }.title { overflow:hidden; color:#222326; font-size:31rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.fee { color:#ef5c38; font-size:27rpx; font-weight:800; }.meta { display:flex; align-items:center; margin:20rpx 0 14rpx; color:#74767d; font-size:24rpx; }.dot { margin:0 10rpx; color:#c9cacf; }.footer { justify-content:space-between; color:#94969d; font-size:24rpx; }.people { color:#4e7d56; font-weight:800; }.end-action { height:64rpx; margin-top:22rpx; border-radius:10rpx; background:#fff1ee; color:#c8472d; font-size:24rpx; font-weight:700; line-height:64rpx; }.end-action:active { background:#ffe3de; }.end-action[disabled] { opacity:.55; }.ended-status { display:inline-flex; align-items:center; height:42rpx; margin-top:20rpx; padding:0 14rpx; border-radius:8rpx; background:#f0f1f3; color:#7d7f85; font-size:21rpx; font-weight:700; }
.cover-mark { overflow:hidden; }.cover-mark image { width:100%; height:100%; }.cover-mark.werewolf { background:#d68491; }.cover-mark.script { background:#aa9bdd; }.cover-mark.mahjong { background:#82c79f; }.cover-mark.catan { background:#dfa662; }.cover-mark.sanguo { background:#d47768; }.cover-mark.cards { background:#74b6dd; }.cover-mark.tabletop { background:#fff14c; }
