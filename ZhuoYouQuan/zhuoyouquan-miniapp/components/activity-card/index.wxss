.card { position:relative; overflow:hidden; padding:26rpx; margin-bottom:20rpx; border-radius:22rpx; background:#fff; box-shadow:0 12rpx 28rpx rgba(34,35,38,.07); }.card:active { opacity:.76; }.topline,.footer { display:flex; align-items:center; }.game-mark { width:70rpx; height:70rpx; margin-right:18rpx; border-radius:18rpx; background:#fff14c; color:#222326; display:flex; align-items:center; justify-content:center; font-size:32rpx; font-weight:900; }.title-group { flex:1; min-width:0; }.game-type { color:#878991; font-size:21rpx; font-weight:700; }.title { overflow:hidden; color:#222326; font-size:31rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.fee { color:#ef5c38; font-size:27rpx; font-weight:800; }.meta { display:flex; align-items:center; margin:20rpx 0 14rpx; color:#74767d; font-size:24rpx; }.dot { margin:0 10rpx; color:#c9cacf; }.footer { justify-content:space-between; color:#94969d; font-size:24rpx; }.people { color:#4e7d56; font-weight:800; }
