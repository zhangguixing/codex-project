page { background:#f7f7f8; color:#202124; font-family:"PingFang SC","Microsoft YaHei",sans-serif; font-size:28rpx; line-height:1.5; } button { margin:0; padding:0; background:transparent; line-height:inherit; } button::after { border:0; }.page { min-height:100vh; padding:34rpx 28rpx calc(148rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }.top-brand { margin-bottom:12rpx; color:#202124; font-size:32rpx; font-weight:900; letter-spacing:1rpx; }.top-brand::after { display:inline-block; padding:3rpx 8rpx; margin-left:8rpx; border-radius:8rpx; background:#252629; color:#fff35d; content:"桌游"; font-size:16rpx; vertical-align:middle; }.eyebrow { color:#8b8d93; font-size:20rpx; font-weight:700; letter-spacing:2rpx; }.section-head { display:flex; align-items:flex-end; justify-content:space-between; margin:42rpx 0 20rpx; }.section-title { color:#202124; font-size:38rpx; font-weight:800; }.section-action { min-height:56rpx; color:#54565b; font-size:25rpx; display:flex; align-items:center; }.primary-button { height:96rpx; border-radius:18rpx; background:#252629; color:#fff; font-size:30rpx; font-weight:800; display:flex; align-items:center; justify-content:center; }.primary-button:active { opacity:.78; }.empty,.loading { padding:88rpx 30rpx; color:#999ba1; text-align:center; }.muted { color:#94969d; }
.page { padding-top:calc(34rpx + env(safe-area-inset-top)); }
.page-tab-title { width:100%; min-height:88rpx; color:#202124; font-family:"PingFang SC","Microsoft YaHei",sans-serif; font-size:42rpx; font-weight:900; letter-spacing:3rpx; line-height:88rpx; text-align:center; text-shadow:0 2rpx 0 rgba(255,255,255,.92),0 7rpx 14rpx rgba(37,38,41,.10); box-sizing:border-box; }
